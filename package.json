{
  "name": "qingmao-game",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "prototype:simulate": "node scripts/prototype-simulate.mjs",
    "prototype:freeze": "node scripts/prototype-freeze.mjs",
    "prototype:replay": "node scripts/prototype-replay.mjs",
    "prototype:audit-combat": "node scripts/prototype-combat-audit.mjs",
    "content:validate": "node scripts/validate-prototype-content.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.0.3",
    "@playwright/test": "1.61.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
